{
  "name": "delve",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "description": "Self-hosted dungeon map editor controlled through an API",
  "scripts": {
    "build": "sh scripts/build-release.sh",
    "build:web": "sh scripts/build-web.sh",
    "release": "npm run build && sudo /usr/local/sbin/delve-release",
    "rollback": "sudo /usr/local/sbin/delve-release --rollback",
    "test": "vitest run",
    "render": "node apps/server/src/cli/render.ts",
    "trace": "node apps/server/src/cli/trace.ts",
    "trace-bench": "node apps/server/src/cli/trace-bench.ts",
    "llm-bench": "node apps/server/src/cli/llm-bench.ts",
    "local-llm": "node apps/server/src/cli/local-llm.ts",
    "demo": "node apps/server/src/cli/demo.ts",
    "mcp": "node apps/server/src/cli/mcp-call.ts",
    "assets": "node scripts/build-assets.ts",
    "colour-props": "node scripts/colour-props.ts",
    "typecheck": "tsc -p . && tsc -p packages/core && tsc -p packages/core/tsconfig.test.json && tsc -p packages/table && tsc -p packages/table/tsconfig.test.json && tsc -p packages/ui && tsc -p packages/ui/tsconfig.test.json && tsc -p apps/server && tsc -p apps/web && tsc -p apps/web/tsconfig.test.json"
  },
  "engines": {
    "node": ">=24"
  },
  "devDependencies": {
    "@types/node": "^24.19.0",
    "esbuild": "^0.28.2",
    "typescript": "^7.0.2",
    "vitest": "^5.0.2"
  },
  "workspaces": [
    "packages/*",
    "apps/server",
    "apps/web"
  ]
}
